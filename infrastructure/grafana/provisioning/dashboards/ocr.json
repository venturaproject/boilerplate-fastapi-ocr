{
  "uid": "ocrer-overview",
  "title": "Ocrer — OCR overview",
  "tags": ["ocrer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "OCR requests/s por modo y estado",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (mode, status) (rate(ocr_requests_total[5m]))",
          "legendFormat": "{{mode}} · {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OCR processing time (ms) — p50 / p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, mode) (rate(ocr_processing_ms_bucket[5m])))",
          "legendFormat": "p50 {{mode}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(ocr_processing_ms_bucket[5m])))",
          "legendFormat": "p95 {{mode}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cola de jobs (ocr_queue_depth)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "ocr_queue_depth", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Cache hit-rate (5m)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(ocr_cache_events_total{event=\"hit\"}[5m])) / clamp_min(sum(rate(ocr_cache_events_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Callbacks / errores de motor (5m)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(ocr_callback_total[5m]))",
          "legendFormat": "callback {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (engine) (rate(ocr_engine_errors_total[5m]))",
          "legendFormat": "engine error {{engine}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP — req/s por código y p95 latencia",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 latency (s)",
          "refId": "B"
        }
      ]
    }
  ],
  "__inputs": [],
  "__requires": []
}
