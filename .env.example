# Project Configuration
COMPOSE_PROJECT_NAME=boilerplate-fastapi-ocr

# PostgreSQL
POSTGRES_DB=fastapi_ocr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT_EXTERNAL=5440

# Backend DB connection
DB_HOST=postgres
DB_NAME=fastapi_ocr_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# JWT — must be at least 32 characters
SECRET_KEY=change-this-to-a-very-long-secret-key-for-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=fastapi-ocr
JWT_AUDIENCE=fastapi-ocr-frontend

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — comma separated
CORS_ALLOWED_ORIGINS=http://localhost:8087

# Nginx port
NGINX_PORT=8087

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_NAME=Admin

# Frontend
VITE_BACKEND_URL=http://localhost:8087
VITE_PUBLIC_API_URL=http://localhost:8087

# App
APP_NAME=FastAPI OCR
APP_URL=http://localhost:8087

# Eventos (CQRS · outbox · inbox)
EVENTS_WORKER_INTERVAL_SECONDS=5
IDEMPOTENCY_KEY_TTL_HOURS=24

# Rate limiting  ("<peticiones>/<segundos>")
THROTTLE_LOGIN=5/60
THROTTLE_EXT_AUTH=10/60
THROTTLE_EXT_API=600/60
THROTTLE_WEBHOOK=120/60
THROTTLE_OCR=30/60

# ── Almacenamiento de subidas ────────────────────────────────────────────────
# "local" (volumen) o "s3" (S3 / S3-compatible; requiere el extra `s3` = boto3)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── OCR ───────────────────────────────────────────────────────────────────────
# Motor: "paddle" (PaddleOCR 3.x), "tesseract" (ligero) o "fake" (stub para tests/CI)
OCR_ENGINE=paddle
# Idioma por defecto (es, en, ch, fr, german, korean, japan, ...)
OCR_LANG=es
# Si no se pasa `lang`, detectarlo del texto y reejecutar una vez (es/en/fr/de/pt)
OCR_LANG_AUTODETECT=false
# Ruta al binario tesseract (vacío = en el PATH); solo para OCR_ENGINE=tesseract
TESSERACT_CMD=
OCR_USE_GPU=false
# PaddlePaddle 3.x: activar el path oneDNN de CPU (roto en algunas CPUs / emulación)
OCR_PADDLE_MKLDNN=false
# DPI al rasterizar PDFs
OCR_PDF_DPI=200
# Límites del endpoint síncrono
OCR_SYNC_MAX_BYTES=10000000
OCR_SYNC_MAX_PAGES=5
# Límite de subida para jobs asíncronos (50 MB)
OCR_MAX_UPLOAD_BYTES=52428800
# Inferencias OCR concurrentes como máximo (por proceso)
OCR_MAX_CONCURRENCY=2
# Tope de megapíxeles por página/imagen renderizada (anti-bomba)
OCR_MAX_IMAGE_MEGAPIXELS=40
# Idiomas permitidos (coma-separada; vacío = set nativo de PaddleOCR)
OCR_ALLOWED_LANGS=
# Ordenar las líneas detectadas por orden de lectura
OCR_SORT_READING_ORDER=true
# Clasificación de documento sobre el texto OCR: "rules" | "none" | "ml" | "llm"
OCR_CLASSIFIER=rules
OCR_CLASSIFIER_MIN_SCORE=2.5
OCR_CLASSIFIER_MIN_CONFIDENCE=0.4
# Extracción de campos por tipo de documento: "rules" | "none" | "llm"
OCR_EXTRACTOR=rules
# Registro de documentos: cada llamada a la API de OCR se guarda en la tabla `documents`.
# Nº de caracteres del texto reconocido que se guardan como extracto (0 = no guardar texto)
DOCUMENT_TEXT_EXCERPT_CHARS=500
# Enmascarar email/DNI/NIE/IBAN/teléfono/tarjeta en el extracto guardado
DOCUMENT_REDACT_PII=false
# Antigüedad para purgar filas de `documents` (0 = conservar para siempre)
DOCUMENT_RETENTION_DAYS=0
# Caché de resultados del endpoint síncrono (por hash de contenido; 0 = desactivada)
OCR_SYNC_CACHE_TTL_SECONDS=300
OCR_SYNC_CACHE_MAX_ENTRIES=64
# Worker de jobs
OCR_WORKER_INTERVAL_SECONDS=2
# Reintentos: un job que falla o cuyo worker se pierde se reintenta hasta N veces
OCR_JOB_MAX_ATTEMPTS=3
# Un job "processing" más viejo que esto se considera colgado y se re-encola
OCR_JOB_STALE_SECONDS=900
# Retención: jobs terminados más viejos que esto se borran (con sus archivos)
OCR_JOB_RETENTION_DAYS=7
OCR_PURGE_INTERVAL_SECONDS=3600
# Cache de modelos de PaddleOCR / PaddleX
OCR_MODEL_DIR=/app/backend/.paddlex

# ── Webhooks de callback ─────────────────────────────────────────────────────
OCR_CALLBACK_TIMEOUT_SECONDS=10
# Permitir callbacks a IPs privadas/loopback (solo despliegues internos / tests)
OCR_CALLBACK_ALLOW_PRIVATE=false
# Lista blanca de hosts para callback_url (coma-separada; vacío = cualquier host público)
OCR_CALLBACK_ALLOWED_HOSTS=
# Secreto para firmar el webhook (HMAC-SHA256); vacío = usa SECRET_KEY
OCR_CALLBACK_SIGNING_SECRET=

# ── Warmup del modelo ────────────────────────────────────────────────────────
OCR_WARMUP_ON_STARTUP=true
# Idiomas a precargar al arranque (coma-separada; vacío = OCR_LANG)
OCR_WARMUP_LANGS=
