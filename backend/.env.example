# ─────────────────────────────────────────────────────────────────────────────
# Configuración del backend para ejecutarlo SUELTO (sin Docker).
#
#   cp .env.example .env
#   uv sync --extra paddle          # o --extra tesseract, o sin extra para "fake"
#   uv run alembic upgrade head
#   uv run python seed.py
#   uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
#   uv run python -m app.ocr.worker          # worker de la cola OCR (proceso aparte)
#
# Con Docker NO se usa este fichero: las variables las inyecta compose desde el
# `.env` de la raíz. Todas las lee `app/config.py::Settings` (pydantic-settings):
# precedencia = variable de entorno real > este `.env` > default de la clase.
# El nombre de cada variable es el del campo en MAYÚSCULAS (DOCS_ENABLED ↔ docs_enabled).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=fastapi_ocr_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ── JWT ──────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres o el backend no arranca (Settings.validate_secret_key()).
SECRET_KEY=change-this-to-a-very-long-secret-key-with-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=fastapi-ocr
JWT_AUDIENCE=fastapi-ocr-frontend
JWT_ALGORITHM=HS256

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=false          # true en producción (HTTPS)
COOKIE_SAMESITE=lax          # lax | strict | none

# ── CORS ─────────────────────────────────────────────────────────────────────
# Solo si el frontend corre en otro origen (p. ej. `pnpm dev` en :5173 pegando a
# la API en :8000). Mismo origen (nginx sirve ambos) -> vacío. Nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Ocrer API
APP_URL=http://localhost:8000
# Swagger UI + ReDoc + /api/openapi.json. En producción: DOCS_ENABLED=false → 404.
DOCS_ENABLED=true

# ── Observabilidad ───────────────────────────────────────────────────────────
LOG_FORMAT=text            # text | json
LOG_LEVEL=INFO
METRICS_TOKEN=             # si se fija, GET /metrics exige Bearer <token>
WORKER_METRICS_PORT=0      # >0: el `python -m app.ocr.worker` sirve /metrics ahí

# ── Bloqueo de cuenta (login del panel) ─────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5        # 0 = desactivado
LOGIN_LOCKOUT_MINUTES=15

# ── Usuario admin (seed) ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_NAME=Admin

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_RECENT_DOCUMENTS_LIMIT=10

# ── Registro de documentos (tabla `documents`) ──────────────────────────────
DOCUMENT_TEXT_EXCERPT_CHARS=500   # nº de caracteres del texto OCR guardados (0 = ninguno)
DOCUMENT_RETENTION_DAYS=0         # 0 = conservar para siempre
DOCUMENT_REDACT_PII=false         # enmascarar email/DNI/NIE/IBAN/teléfono/tarjeta en el extracto

# ── Eventos (CQRS · outbox · inbox) ─────────────────────────────────────────
EVENTS_WORKER_INTERVAL_SECONDS=5
IDEMPOTENCY_KEY_TTL_HOURS=24

# ── Rate limiting  ("<peticiones>/<segundos>") ─────────────────────────────
THROTTLE_LOGIN=5/60
THROTTLE_EXT_AUTH=10/60
THROTTLE_EXT_API=600/60
THROTTLE_WEBHOOK=120/60
THROTTLE_OCR=30/60               # default; se sobrescribe por api_client.rate_limit

# ── Almacenamiento de subidas ───────────────────────────────────────────────
STORAGE_BACKEND=local            # local | s3 (s3 requiere el extra `s3` = boto3)
MEDIA_DIR=./media                # los archivos OCR van a ./media/ocr/
S3_BUCKET=
S3_PREFIX=ocr/
S3_ENDPOINT_URL=                 # p. ej. http://localhost:9000 para MinIO
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── OCR ──────────────────────────────────────────────────────────────────────
OCR_ENGINE=paddle                # paddle | tesseract | fake (stub para tests/CI)
OCR_LANG=es
OCR_LANG_AUTODETECT=false        # si no se pasa `lang`, detectarlo y reejecutar una vez
TESSERACT_CMD=                   # ruta al binario tesseract (vacío = en el PATH)
OCR_USE_GPU=false
OCR_PADDLE_MKLDNN=false          # path oneDNN de CPU de PaddlePaddle 3.x (roto en algunas CPUs)
OCR_PDF_TEXT_LAYER=true       # digital PDFs: leer la capa de texto embebida
OCR_PDF_TEXT_MIN_CHARS=16     # página con menos texto real que esto = escaneada
OCR_PDF_DPI=200
OCR_SYNC_MAX_BYTES=10000000
OCR_SYNC_MAX_PAGES=5
OCR_MAX_UPLOAD_BYTES=52428800
OCR_MAX_CONCURRENCY=2            # inferencias OCR simultáneas por proceso
OCR_MAX_IMAGE_MEGAPIXELS=40      # tope por página/imagen renderizada (anti-bomba)
OCR_ALLOWED_LANGS=               # coma-separada; vacío = set nativo de PaddleOCR
OCR_SORT_READING_ORDER=true
OCR_MODEL_DIR=./.paddlex         # caché de modelos PaddleOCR / PaddleX

# Clasificación de documento (sobre el texto OCR)
OCR_CLASSIFIER=rules             # none | rules | ml | llm
OCR_CLASSIFIER_MIN_SCORE=2.5
OCR_CLASSIFIER_MIN_CONFIDENCE=0.4

# Extracción de campos por tipo de documento
OCR_EXTRACTOR=rules              # none | rules | llm

# Extractor LLM (OCR_EXTRACTOR=llm) — cualquier endpoint chat-completions
# compatible con OpenAI. Por defecto NVIDIA NIM; cambia la base URL para usar
# OpenAI directamente, un vLLM/Ollama propio, etc. Vacío = no-op (con warning).
OCR_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
OCR_LLM_MODEL=meta/llama-3.2-11b-vision-instruct
OCR_LLM_API_KEY=
OCR_LLM_TIMEOUT_SECONDS=20
OCR_LLM_MAX_TOKENS=512
OCR_LLM_REDACT_PII=true

# Caché de resultados del endpoint síncrono (por hash de contenido; 0 = off)
OCR_SYNC_CACHE_TTL_SECONDS=300
OCR_SYNC_CACHE_MAX_ENTRIES=64

# Worker de la cola de jobs
OCR_WORKER_INTERVAL_SECONDS=2
OCR_JOB_MAX_ATTEMPTS=3
OCR_JOB_STALE_SECONDS=900        # un job "processing" más viejo que esto se re-encola
OCR_JOB_RETENTION_DAYS=7         # jobs terminados más viejos se purgan (con sus archivos)
OCR_PURGE_INTERVAL_SECONDS=3600

# Webhooks de callback
OCR_CALLBACK_TIMEOUT_SECONDS=10
OCR_CALLBACK_ALLOW_PRIVATE=false # permitir callbacks a IPs privadas/loopback (solo interno)
OCR_CALLBACK_ALLOWED_HOSTS=      # lista blanca (coma-separada); vacío = cualquier host público
OCR_CALLBACK_SIGNING_SECRET=     # HMAC-SHA256; vacío = usa SECRET_KEY
OCR_CALLBACK_MAX_ATTEMPTS=5      # dead-letter tras N entregas fallidas
OCR_CALLBACK_BACKOFF_BASE_SECONDS=60

# Lotes
OCR_BATCH_MAX_FILES=50

# Cuota mensual de páginas por defecto (0 = ilimitada; override por api_client.monthly_page_quota)
OCR_DEFAULT_MONTHLY_PAGE_QUOTA=0

# Warmup del modelo al arranque
OCR_WARMUP_ON_STARTUP=true
OCR_WARMUP_LANGS=                # coma-separada; vacío = [OCR_LANG]
